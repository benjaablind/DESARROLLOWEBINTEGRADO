{
  "info": {
    "name": "Laboratorio 10 - Integracion del back-end seguro (Marco Gonzales del Valle)",
    "description": "Matriz de pruebas de integracion de la seccion 13 de la guia (E01 a E12), mas la evidencia de commit y rollback de la seccion 12. Ejecutar en orden con Run collection: los logins guardan los tokens en variables de la coleccion.\n\nRequisitos: API en http://localhost:8080 con MySQL (productos_db) y JWT_SECRET_BASE64 definida.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tokenUser",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "productoId",
      "value": ""
    },
    {
      "key": "stockAntes",
