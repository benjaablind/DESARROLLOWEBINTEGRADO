                {
                  "key": "max",
                  "value": "1000"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenUser}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const lista = pm.response.json();",
                  "pm.test(\"Todos los precios estan entre 100 y 1000\", () => lista.forEach(p => pm.expect(p.precio).to.be.within(100, 1000)));",
                  "pm.test(\"Ordenados por precio ascendente\", () => { for (let i = 1; i < lista.length; i++) pm.expect(lista[i].precio).to.be.at.least(lista[i - 1].precio); });"
                ]
              }
            }
          ]
