{
  "info": {
    "name": "Laboratorio 06 - Productos (JPA + MySQL)",
    "description": "Operaciones CRUD de la Guia de Laboratorio 06. Marco Antonio Gonzales del Valle Vargas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/productos"
    }
  ],
  "item": [
    {
      "name": "15.1 CREATE - crear producto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Laptop Lenovo\",\n  \"precio\": 3500,\n  \"stock\": 10,\n  \"categoria\": \"Tecnologia\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}",
          "host": ["{{baseUrl}}"]
        },
        "description": "Esperado: 201 Created y un JSON con el id generado por MySQL."
      }
    },
    {
      "name": "15.2 READ - listar productos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}",
          "host": ["{{baseUrl}}"]
        },
        "description": "Esperado: 200 OK y una lista JSON."
      }
    },
    {
      "name": "15.3 READ - obtener por id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/1",
          "host": ["{{baseUrl}}"],
          "path": ["1"]
        },
        "description": "Esperado: 200 si existe, 404 si el id no esta registrado."
      }
    },
    {
      "name": "15.4 UPDATE - actualizar producto completo",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Laptop Lenovo Pro\",\n  \"precio\": 3900,\n  \"stock\": 8,\n  \"categoria\": \"Tecnologia\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/1",
          "host": ["{{baseUrl}}"],
          "path": ["1"]
        },
        "description": "Esperado: 200 OK con el producto actualizado."
      }
    },
    {
      "name": "15.5 PATCH - actualizar solo el precio",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/1/precio?valor=4200",
          "host": ["{{baseUrl}}"],
          "path": ["1", "precio"],
          "query": [
            {
              "key": "valor",
              "value": "4200"
            }
          ]
        },
        "description": "Esperado: 200 OK con el precio modificado."
      }
    },
    {
      "name": "15.6 DELETE - eliminar producto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/1",
          "host": ["{{baseUrl}}"],
          "path": ["1"]
        },
        "description": "Esperado: 204 No Content."
      }
    }
  ]
}
